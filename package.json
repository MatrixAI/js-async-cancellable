{
  "name": "@matrixai/async-cancellable",
  "version": "3.0.0",
  "author": "Roger Qiu",
  "description": "Scoped cancellation providers and explicit cancellable waiting",
  "keywords": [
    "promise",
    "cancel",
    "cancellable"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatrixAI/js-async-cancellable.git"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": "./dist/*"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "prepare": "tsc -p ./tsconfig.build.json",
    "build": "shx rm -rf ./dist && tsc -p ./tsconfig.build.json",
    "postversion": "npm install --package-lock-only --ignore-scripts --silent",
    "tsx": "tsx",
    "test": "node ./scripts/test.mjs",
    "lint": "matrixai-lint",
    "lintfix": "matrixai-lint --fix",
    "typecheck": "tsc -p ./tsconfig.json",
    "check:package": "npm run build && node ./scripts/check-package.mjs",
    "check:portable": "node --experimental-import-meta-resolve ./scripts/check-portable.mjs",
    "check:conformance": "npm run typecheck && npm test -- --runInBand && npm run check:package && npm run check:portable",
    "check": "npm run check:conformance && npm run lint"
  },
  "dependencies": {
    "@matrixai/contexts": "git+ssh://git@github.com/MatrixAI/js-contexts.git#v3.0.0"
  },
  "devDependencies": {
    "@swc/core": "1.3.82",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^29.5.2",
    "@types/node": "^24.19.0",
    "jest": "^29.6.2",
    "jest-extended": "^4.0.0",
    "jest-junit": "^16.0.0",
    "shx": "^0.3.4",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3",
    "esbuild": "0.28.2"
  },
  "engines": { "node": ">=24.0.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "!dist/tsbuildinfo"]
}
