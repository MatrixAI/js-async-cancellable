{
  "name": "@matrixai/async-cancellable",
  "version": "4.0.0",
  "author": "Roger Qiu",
  "description": "Scoped cancellation providers and explicit cancellable waiting",
  "keywords": [
    "promise",
    "cancel",
    "cancellable"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatrixAI/js-async-cancellable.git"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "prepare": "tsc -p ./tsconfig.build.json",
    "build": "shx rm -rf ./dist && tsc -p ./tsconfig.build.json",
    "postversion": "npm install --package-lock-only --ignore-scripts --silent",
    "tsx": "tsx",
    "test": "node ./scripts/test.mjs",
    "lint": "matrixai-lint --check",
    "lintfix": "matrixai-lint --fix",
    "typecheck": "tsc -p ./tsconfig.json",
    "check:portable": "node --experimental-import-meta-resolve ./scripts/check-portable.mjs",
    "check:conformance": "npm run typecheck && npm test -- --no-file-parallelism && npm run build",
    "check": "npm run check:conformance && npm run lint"
  },
  "dependencies": {
    "@matrixai/contexts": "git+ssh://git@github.com/MatrixAI/js-contexts.git#v4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "5.1.0",
    "shx": "^0.3.4",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  },
  "engines": { "node": ">=24.0.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "!dist/tsbuildinfo"]
}
